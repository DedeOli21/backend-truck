{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "cloudformation:*",
          "lambda:*",
          "apigateway:*",
          "iam:CreateRole",
          "iam:DeleteRole",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:PutRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:PassRole",
          "iam:GetRole",
          "iam:TagRole",
          "iam:UntagRole",
          "logs:*",
          "s3:*",
          "events:*",
          "sts:GetCallerIdentity"
        ],
        "Resource": "*"
      }
    ]
  }
  