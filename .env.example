# App
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh

# PostgreSQL
DATABASE_URL=postgresql://truck_admin:truck_password@localhost:5432/truckdb
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=truck_admin
DATABASE_PASSWORD=truck_password
DATABASE_NAME=truckdb
DATABASE_SSL=false

# AWS Lambda VPC (Serverless deploy)
LAMBDA_SG_ID=sg-xxxxxxxxxxxxxxxxx
PRIVATE_SUBNET_1_ID=subnet-xxxxxxxxxxxxxxxxx
PRIVATE_SUBNET_2_ID=subnet-yyyyyyyyyyyyyyyyy

CORS_ORIGINS=https://main.domernyar0nvy1.amplifyapp.com,https://main.dnmemvgn9yvq4.amplifyapp.com,https://main.dnmemvgn9yqv4.amplifyapp.com,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Drivers module
# Directory where CNH images are stored. Defaults to <cwd>/uploads/drivers/cnh if unset.
DRIVER_CNH_UPLOADS_DIR=

# --- Consulta de NF-e na SEFAZ (opcional) ---
# Sem NFE_CERT_PATH e NFE_CERT_PASSWORD, a API responde sefaz.consultado=false
# com o motivo, em vez de tentar consultar.
NFE_CERT_PATH=/app/certs/nfe-a1.pfx
NFE_CERT_PASSWORD=
# 1 = producao, 2 = homologacao
NFE_AMBIENTE=1
# Sobrescreve o endpoint por UF, util para homologacao especifica
NFE_CONSULTA_URL=
NFE_TIMEOUT_MS=20000

# --- Emissao de CT-e (opcional) ---
# 2 = homologacao (padrao, sem valor fiscal), 1 = producao
CTE_AMBIENTE=2
CTE_SERIE=1
# Dados do emitente, usados para montar o CT-e
CTE_EMIT_CNPJ=
CTE_EMIT_IE=
CTE_EMIT_NOME=
# 1 e 2 = Simples Nacional, 3 = regime normal
CTE_EMIT_CRT=1
CTE_EMIT_RNTRC=
CTE_EMIT_LOGRADOURO=
CTE_EMIT_NUMERO=
CTE_EMIT_BAIRRO=
CTE_EMIT_MUNICIPIO=
# Codigo IBGE do municipio do emitente
CTE_EMIT_COD_MUNICIPIO=
CTE_EMIT_CEP=
CTE_EMIT_UF=

