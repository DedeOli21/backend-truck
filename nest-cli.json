{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "modules/nf-e/infrastructure/sefaz/ca/*.pem",
        "outDir": "dist"
      },
      {
        "include": "modules/nf-e/infrastructure/dacte/assets/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
